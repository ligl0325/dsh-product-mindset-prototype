{
  "name": "dsh-product-mindset-prototype",
  "version": "1.1.0",
  "description": "Product management skill pack for DeepSeek Harness: product-mindset (产品心法 v2.0.0) and quick-prototype (快速原型 v4.3.0) shipped as one installable skill provider.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ligl0325/dsh-product-mindset-prototype.git"
  },
  "homepage": "https://github.com/ligl0325/dsh-product-mindset-prototype#readme",
  "bugs": {
    "url": "https://github.com/ligl0325/dsh-product-mindset-prototype/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "tools/validate.mjs",
    "tools/smoke.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node tools/validate.mjs && node tools/smoke.mjs",
    "test": "node tools/smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "product-management",
    "prd",
    "requirement",
    "prototype",
    "产品经理",
    "原型"
  ],
  "license": "MIT"
}
